rules_version = '2';
// Coffee Nhẫn To Go — Firestore security rules.
// Paste into Firebase console → Firestore Database → Rules → Publish.
// Admin = verified email listed below (keep in sync with NHAN.ADMIN_EMAILS in assets/js/data.js).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['coffeenhan178@gmail.com'];
    }
    function userDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isBanned() { return exists(userDoc()) && get(userDoc()).data.get('banned', false) == true; }
    // fields only the admin may set
    function touchesModeration() {
      return request.resource.data.diff(resource == null ? {} : resource.data).affectedKeys()
        .hasAny(['banned', 'banReason', 'bannedAt', 'bannedBy', 'deleted', 'deletedAt']);
    }

    // Customer profiles: owners read/write their own document (not moderation fields); admin full access.
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if isAdmin() || (signedIn() && request.auth.uid == uid && !touchesModeration());
      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && !isBanned() && !touchesModeration());
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid && !isBanned());
    }

    // Orders: verified, non-banned customers create their own orders; admin manages all.
    match /orders/{code} {
      allow create: if signedIn()
        && request.auth.token.email_verified == true
        && !isBanned()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['code', 'customer', 'items', 'delivery', 'payment'])
        && request.resource.data.code == code
        && request.resource.data.status == 'pending'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 50;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      // customers may only cancel their own order while it is still "pending" (not yet confirmed)
      allow update: if isAdmin() || (signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy', 'cancelledAt']));
      allow delete: if isAdmin();
    }

    // Shop settings (open / paused, sold-out items, prices): public read, admin write.
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}